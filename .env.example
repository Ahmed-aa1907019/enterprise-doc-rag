# ==============================================================================
# Bilingual (Arabic/English) RAG Document Assistant — Configuration Template
# Copy this file to `.env` and fill in your API key before running live queries.
# ==============================================================================

# --- Application ---
APP_NAME="Bilingual RAG Document Assistant"
APP_ENV=development
LOG_LEVEL=INFO

# --- LLM Provider (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1

# --- Embeddings (Local Multilingual E5) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_BATCH_SIZE=32

# --- Local Persistence Paths ---
UPLOAD_DIR=data/uploads
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=enterprise_docs

# --- PDF Ingestion & Chunking ---
MAX_UPLOAD_MB=25
MIN_CHARS_PER_PAGE=20
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Retrieval & Grounding ---
DEFAULT_TOP_K=5
MIN_RELEVANCE_SCORE=0.72
